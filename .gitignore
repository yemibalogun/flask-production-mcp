# --- Python bytecode / build artifacts ---
__pycache__/
*.py[cod]
*$py.class
build/
dist/
wheels/
*.egg
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Packaging / dependency tools ---
pip-wheel-metadata/
.uv/

# --- Test / type / lint caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/

# --- Coverage ---
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml

# --- Secrets / local config (keep the example, never the real thing) ---
.env
.env.*
!.env.example
*.local.toml

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs / scratch ---
*.log
/scratch/
/tmp/
